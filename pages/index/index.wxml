<view class="container">
  <view class="userinfo">
    <block wx:if="{{!hasUserInfo}}">
      <button wx:if="{{canIUseGetUserProfile}}" bindtap="getUserProfile" class="userinfo-btn">
        获取头像昵称
      </button>
      <button wx:else open-type="getUserInfo" bindgetuserinfo="getUserInfo" class="userinfo-btn">
        获取头像昵称
      </button>
    </block>
    <block wx:else>
      <image class="userinfo-avatar" src="{{userInfo.avatarUrl}}" mode="cover"></image>
      <text class="userinfo-nickname">{{userInfo.nickName}}</text>
    </block>
  </view>

  <view class="usermotto">
    <text class="user-motto">{{motto}}</text>
  </view>

  <view class="counter-section">
    <text class="counter-title">计数器示例</text>
    <view class="counter-display">
      <text class="counter-number">{{count}}</text>
    </view>
    <view class="counter-buttons">
      <button class="counter-btn minus" bindtap="decrement">-</button>
      <button class="counter-btn plus" bindtap="increment">+</button>
    </view>
  </view>

  <view class="booking-section">
    <text class="section-title">网球场预约</text>
    <view class="booking-card" bindtap="navigateToCourtList">
      <view class="booking-icon">🎾</view>
      <view class="booking-info">
        <text class="booking-title">北京网球场预约</text>
        <text class="booking-desc">选择球场 · 预约时段 · 即刻开拍</text>
      </view>
      <text class="booking-arrow">›</text>
    </view>
  </view>

  <view class="nav-section">
    <button class="nav-btn" bindtap="navigateToCourtList">立即预约球场</button>
  </view>
</view>
