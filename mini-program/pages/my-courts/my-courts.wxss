.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  position: relative;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #666;
}

.clear-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #ff4d4f;
  background: transparent;
  padding: 0;
  border: none;
}

.clear-btn::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  background-color: #fff;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 50rpx;
}

.court-list {
  padding: 0 20rpx;
}

.court-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.court-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.court-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.court-date {
  font-size: 24rpx;
  color: #999;
}

.court-info {
  margin-bottom: 20rpx;
}

.court-address {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.court-details {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-item {
  font-size: 22rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.court-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.visit-count {
  font-size: 24rpx;
  color: #07c160;
}

.delete-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  background: transparent;
  padding: 0;
  border: none;
}

.delete-btn::after {
  border: none;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}
