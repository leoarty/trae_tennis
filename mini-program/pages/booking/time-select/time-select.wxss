.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.court-info-bar {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.court-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.court-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.date-section {
  background-color: #fff;
  padding: 30rpx;
  margin-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.date-list {
  white-space: nowrap;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  min-width: 120rpx;
}

.date-item.active {
  background-color: #07c160;
}

.date-item.active .date-week,
.date-item.active .date-day {
  color: #fff;
}

.date-week {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.date-day {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.time-section {
  background-color: #fff;
  padding: 30rpx;
  margin-top: 20rpx;
}

.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-item {
  width: calc(25% - 12rpx);
  padding: 20rpx 0;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

.time-item.unavailable {
  background-color: #f0f0f0;
  opacity: 0.6;
}

.time-item.selected {
  background-color: #e6f7e6;
  border-color: #07c160;
}

.time-text {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.time-status {
  font-size: 20rpx;
  color: #07c160;
}

.time-item.unavailable .time-status {
  color: #999;
}

.time-item.selected .time-status {
  color: #07c160;
  font-weight: 500;
}

.booking-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.booking-info {
  display: flex;
  flex-direction: column;
}

.selected-count {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.total-price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.submit-btn {
  background-color: #ccc;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 50rpx;
  border-radius: 8rpx;
  border: none;
}

.submit-btn.active {
  background-color: #07c160;
}
