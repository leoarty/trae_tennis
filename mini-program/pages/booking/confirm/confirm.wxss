.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.order-card,
.contact-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  min-width: 120rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
}

.time-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  flex: 1;
  gap: 10rpx;
}

.time-tag {
  background-color: #e6f7e6;
  color: #07c160;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.price-row {
  align-items: center;
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #f0f0f0;
}

.price-value {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.input-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-row:last-child {
  border-bottom: none;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.textarea-field {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  width: auto;
  height: 160rpx;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.price-summary {
  display: flex;
  align-items: baseline;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-price {
  font-size: 44rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-left: 8rpx;
}

.submit-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 60rpx;
  border-radius: 8rpx;
  border: none;
}
