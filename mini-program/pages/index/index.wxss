.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  margin-top: 40rpx;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.userinfo-nickname {
  color: #333;
  font-size: 32rpx;
  margin-top: 10rpx;
}

.userinfo-btn {
  margin-top: 40rpx;
  background-color: #07c160;
  color: white;
  border-radius: 8rpx;
}

.usermotto {
  margin-top: 40rpx;
  text-align: center;
}

.user-motto {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.counter-section {
  margin-top: 60rpx;
  padding: 40rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  width: 80%;
}

.counter-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.counter-display {
  text-align: center;
  margin: 30rpx 0;
}

.counter-number {
  font-size: 96rpx;
  font-weight: bold;
  color: #07c160;
}

.counter-buttons {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.counter-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  border: none;
}

.counter-btn.minus {
  background-color: #ff4d4f;
}

.counter-btn.plus {
  background-color: #07c160;
}

.nav-section {
  margin-top: 60rpx;
  width: 80%;
}

.nav-btn {
  background-color: #1890ff;
  color: white;
  border-radius: 8rpx;
  width: 100%;
}
